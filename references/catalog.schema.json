{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "brand",
    "official_url",
    "region",
    "as_of",
    "coverage",
    "sources",
    "nodes"
  ],
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "region": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "samples_per_category": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "brand_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "text",
          "basis",
          "source_url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "official",
              "inferred"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "title"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent_id",
          "name",
          "official_name",
          "source_url",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "official_name": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "basis": {
            "enum": [
              "official",
              "inferred"
            ]
          },
          "classification_logic": {
            "type": "string"
          },
          "inventory_complete": {
            "type": "boolean"
          },
          "listed_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "selection_basis": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "inventory": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "product_url"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "product_url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "selected_products": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "name",
                "product_url",
                "image_url",
                "image_kind"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string"
                },
                "feature": {
                  "type": "string"
                },
                "product_url": {
                  "type": "string",
                  "format": "uri"
                },
                "image_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image_evidence_url": {
                  "type": "string",
                  "format": "uri"
                },
                "image_kind": {
                  "enum": [
                    "official_product",
                    "official_scene",
                    "official_software",
                    "missing"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "required": [
        "accent_color",
        "basis",
        "source_url"
      ],
      "properties": {
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "basis": {
          "enum": [
            "official",
            "inferred"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}